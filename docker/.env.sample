# Database shared by the app and Supabase Compose service
SUPABASE_DB_PASSWORD=change-this-password
SUPABASE_DB_NAME=postgres
DATABASE_URL=postgresql://postgres:${SUPABASE_DB_PASSWORD}@supabase:5432/postgres

# App and first-run agent registration
JWT_SECRET=generate-a-random-hex-secret
NEXT_PUBLIC_SITE_SIGNUP_STRATEGY=ANY
USER_DEFAULT_STATUS=active
GRAPHQL_ENDPOINT=http://localhost:4000/api

# n8n
N8N_ENCRYPTION_KEY=generate-a-random-hex-key
N8N_SECURE_COOKIE=false
N8N_BOOTSTRAP_ACTIVATE_WORKFLOWS=true
N8N_PERSONALIZATION_ENABLED=false
NODES_EXCLUDE=[]
NODE_FUNCTION_ALLOW_EXTERNAL=node-fetch

# Direct GraphQL LLM API: fill the selected provider only
# OPENROUTER_API_KEY=
# LLM_LOCAL_API_URL=http://llama:8080/v1
# LLM_LOCAL_API_KEY=

# Optional services and production routing
TURN_SECRET=generate-a-random-secret
# LLAMA_MODEL=unsloth/Qwen3.5-0.8B-GGUF/Qwen3.5-0.8B-Q8_0.gguf
# TRAEFIK_STATIC_CONFIG=./traefik/traefik.prod.yml
# TRAEFIK_DYNAMIC_DIR=./traefik/dynamic/prod
