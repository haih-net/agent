{
  "name": "MindLog: Search",
  "active": true,
  "versionId": "s1e2a3r4",
  "nodes": [
    {
      "parameters": {
        "workflowInputs": {
          "values": [
            {
              "name": "type"
            },
            {
              "name": "days",
              "type": "number"
            },
            {
              "name": "limit",
              "type": "number"
            }
          ]
        }
      },
      "id": "trigger-search",
      "name": "Execute Workflow Trigger",
      "type": "n8n-nodes-base.executeWorkflowTrigger",
      "typeVersion": 1.1,
      "position": [0, 0]
    },
    {
      "parameters": {},
      "id": "manual-trigger-search",
      "name": "Manual Trigger",
      "type": "n8n-nodes-base.manualTrigger",
      "typeVersion": 1,
      "position": [-200, 200]
    },
    {
      "parameters": {
        "mode": "raw",
        "jsonOutput": "{\n  \"type\": \"Knowledge\",\n  \"days\": 30,\n  \"limit\": 50\n}",
        "options": {}
      },
      "id": "test-data-search",
      "name": "Test Data",
      "type": "n8n-nodes-base.set",
      "typeVersion": 3.4,
      "position": [0, 200]
    },
    {
      "parameters": {
        "command": "=/home/node/databases/knowledge/scripts/search-mindlogs.sh \"{{ $json.type || '' }}\" \"{{ $json.days || '' }}\" {{ $json.limit || 50 }}"
      },
      "id": "exec-search",
      "name": "Execute Search",
      "type": "n8n-nodes-base.executeCommand",
      "typeVersion": 1,
      "position": [250, 0]
    },
    {
      "parameters": {
        "jsCode": "const output = $input.first().json.stdout || '[]';\ntry {\n  const results = JSON.parse(output);\n  return [{ results, count: results.length }];\n} catch (e) {\n  return [{ results: [], count: 0, error: output }];\n}"
      },
      "id": "parse-result-search",
      "name": "Parse Result",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [500, 0]
    }
  ],
  "connections": {
    "Execute Workflow Trigger": {
      "main": [[{"node": "Execute Search", "type": "main", "index": 0}]]
    },
    "Manual Trigger": {
      "main": [[{"node": "Test Data", "type": "main", "index": 0}]]
    },
    "Test Data": {
      "main": [[{"node": "Execute Search", "type": "main", "index": 0}]]
    },
    "Execute Search": {
      "main": [[{"node": "Parse Result", "type": "main", "index": 0}]]
    }
  },
  "pinData": {},
  "settings": {
    "executionOrder": "v1"
  }
}
