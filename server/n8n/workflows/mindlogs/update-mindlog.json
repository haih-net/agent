    {
      "parameters": {
        "jsCode": "const output = $input.first().json.stdout || '';\ntry {\n  return [JSON.parse(output)];\n} catch (e) {\n  return [{ success: false, error: output }];\n}"
      },
      "id": "parse-result-update",
